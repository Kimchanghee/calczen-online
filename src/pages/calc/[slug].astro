---
import Layout from '../../layouts/Layout.astro';
import { CALCULATORS, CATEGORY_LABEL, getCalcsByCategory } from '../../lib/calculators.ts';
import { contentFor, exampleFor, CONTENT_UPDATED } from '../../lib/calc-content.ts';

export async function getStaticPaths() {
  return CALCULATORS.map((c) => ({ params: { slug: c.slug }, props: { calc: c } }));
}

const { calc } = Astro.props;
const related = getCalcsByCategory(calc.category).filter((c) => c.slug !== calc.slug).slice(0, 3);
const content = contentFor(calc);
const example = exampleFor(calc.slug);
const categoryLabel = CATEGORY_LABEL[calc.category];
const url = `https://calczen.online/calc/${calc.slug}`;

const suffix = ' 기본 입력 예시, 계산식, 반영되지 않는 조건을 함께 확인하세요.';
const description = (content.what + suffix).length <= 165 ? content.what + suffix : content.what;
const title = `${calc.name} · 계산식과 예시 | CalcZen`;

const faqs = [
  { question: `${calc.name}: 무엇을 계산하나요?`, answer: content.what },
  { question: '어떤 산식을 사용하나요?', answer: content.formula.join(' / ') },
  { question: '계산 결과에 반영되지 않는 것은 무엇인가요?', answer: content.limits },
];

const appCategory = calc.category === 'life' && ['bmi', 'calorie', 'pregnancy-week'].includes(calc.slug)
  ? 'HealthApplication'
  : calc.category === 'life' ? 'UtilitiesApplication' : 'FinanceApplication';

const ldJson = {
  '@type': 'WebApplication',
  '@id': `${url}#app`,
  name: calc.name,
  url,
  description: content.what,
  applicationCategory: appCategory,
  operatingSystem: 'Any',
  browserRequirements: 'JavaScript가 필요합니다.',
  inLanguage: 'ko-KR',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'KRW' },
  publisher: { '@id': 'https://calczen.online/#organization' },
  dateModified: CONTENT_UPDATED,
};
---

<Layout
  title={title}
  description={description}
  canonicalPath={`/calc/${calc.slug}`}
  keywords={calc.keywords}
  indexable
  faqs={faqs}
  ldJson={ldJson}
  breadcrumbs={[
    { name: '홈', url: 'https://calczen.online/' },
    { name: categoryLabel, url: `https://calczen.online/categories/${calc.category}` },
    { name: calc.name, url },
  ]}
>

<main class="container mx-auto max-w-3xl px-4 py-8">
  <h1 class="text-3xl font-bold tracking-tight">{calc.name}</h1>
  <p class="mt-3 rounded-lg border-l-4 border-emerald-500 bg-emerald-50 p-4 text-slate-800"><strong>결론부터:</strong> {content.what}</p>

  <div id="calc-mount" data-slug={calc.slug} class="mt-6 rounded-xl border bg-white p-6">
    <p class="text-center text-slate-500 py-12">계산 도구를 불러오는 중입니다. 입력·계산에는 JavaScript가 필요합니다.</p><noscript><p>JavaScript가 꺼져 있습니다. 설명과 계산 기준은 읽을 수 있지만 계산하려면 JavaScript를 켜세요.</p></noscript>
  </div>

  {example && (
    <section class="mt-8 rounded-xl border bg-white p-6" aria-labelledby="example-title">
      <h2 id="example-title" class="text-xl font-semibold">기본 입력 예시와 결과</h2>
      <p class="mt-2 text-sm text-slate-600">아래 값은 이 계산기가 처음 열릴 때 채워져 있는 기본 입력값이며, 같은 계산 모듈로 산출한 결과입니다. 실제 상황의 값이 아닙니다.</p>
      {example.inputs.length > 0 && (
        <table class="mt-4 w-full text-sm">
          <caption class="mb-1 text-left font-semibold">입력값</caption>
          <tbody>
            {example.inputs.map(([k, v]) => <tr class="border-t"><th scope="row" class="py-2 pr-4 text-left font-normal text-slate-600">{k}</th><td class="py-2 text-right font-mono">{v}</td></tr>)}
          </tbody>
        </table>
      )}
      <table class="mt-4 w-full text-sm">
        <caption class="mb-1 text-left font-semibold">결과: {example.headline}</caption>
        <tbody>
          {example.rows.map(([k, v]) => <tr class="border-t"><th scope="row" class="py-2 pr-4 text-left font-normal text-slate-600">{k}</th><td class="py-2 text-right font-mono">{v}</td></tr>)}
        </tbody>
      </table>
    </section>
  )}

  <section class="mt-8 rounded-xl border bg-white p-6">
    <h2 class="text-xl font-semibold">계산 방법</h2>
    <p class="mt-2 text-sm text-slate-600">이 계산기에 실제로 구현된 산식입니다.</p>
    <ol class="mt-3 list-decimal space-y-2 pl-5 text-sm leading-6 text-slate-700">
      {content.formula.map((line) => <li>{line}</li>)}
    </ol>
  </section>

  <section class="mt-8 rounded-xl border bg-slate-50 p-6">
    <h2 class="text-xl font-semibold">결과 해석 시 주의할 점</h2>
    <p class="mt-3 text-sm leading-6 text-slate-700">{content.limits}</p>
    <p class="mt-3 text-sm leading-6 text-slate-700">결과는 참고용 추정치이며 법적·세무적 효력이 없습니다. 자세한 기준은 <a class="underline" href="/methodology">계산 기준과 한계</a>, <a class="underline" href="/disclaimer">면책 고지</a>를 확인하세요.</p>
    {content.checkWith.length > 0 && (
      <p class="mt-3 text-sm leading-6 text-slate-700">실제 적용 전 확인할 수 있는 곳:
        {content.checkWith.map((c, i) => <span>{i > 0 ? ', ' : ' '}<a class="underline" href={c.url} rel="noopener noreferrer" target="_blank">{c.name}</a></span>)}
        (링크는 확인 창구이며 이 계산기와의 제휴·공식 검증을 뜻하지 않습니다.)
      </p>
    )}
  </section>

  {related.length > 0 && (
    <section class="mt-8">
      <h2 class="mb-3 text-lg font-semibold">관련 계산기</h2>
      <ul class="space-y-2">
        {related.map((r) => (
          <li>
            <a href={`/calc/${r.slug}`} class="block rounded-lg border bg-white p-3 hover:border-emerald-400">
              <span class="font-medium">{r.name}</span>
              <span class="ml-2 text-sm text-slate-500">{r.description}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</main>

<script>
  /**
   * 계산기 라우터 — slug에 매칭되는 계산기 모듈을 lazy import 후 마운트.
   * 새 계산기 추가 시 이 매핑에만 등록하면 자동 동작.
   */
  const REGISTRY: Record<string, () => Promise<{ default?: any; [key: string]: any }>> = {
    'loan-monthly-payment': () => import('../../calculators/loan-monthly-payment.ts'),
    'salary-net-calculator': () => import('../../calculators/salary-net.ts'),
    'severance-pay': () => import('../../calculators/severance.ts'),
    'bmi': () => import('../../calculators/bmi.ts'),
  };

  const mount = document.getElementById('calc-mount');
  const slug = mount?.dataset.slug;
  if (mount && slug) {
    const loader = REGISTRY[slug];
    const mounting = loader
      ? loader().then((mod) => {
          const fnName = Object.keys(mod).find((k) => k.startsWith('mount'));
          if (!fnName || typeof mod[fnName] !== 'function') throw new Error('마운트 함수를 찾을 수 없습니다.');
          mod[fnName](mount);
        })
      : import('../../calculators/general.ts').then((mod) => mod.mountGeneralCalculator(mount, slug));

    mounting.catch((error) => {
      const message = error instanceof Error ? error.message : '알 수 없는 오류';
      mount.innerHTML = `<div class="rounded-lg bg-red-50 p-4 text-sm text-red-700">계산기 로드 실패: ${message}</div>`;
    });
  }
</script>
</Layout>
